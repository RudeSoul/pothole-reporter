FROM public.ecr.aws/lambda/python:3.12@sha256:ab6df78b68b50723c93741bb7f9ea9f68c7cf3433359b33e4f37db5266567f9c
ENV POTHOLE_LAMBDA_BASE_IMAGE_DIGEST=sha256:ab6df78b68b50723c93741bb7f9ea9f68c7cf3433359b33e4f37db5266567f9c

# Match the native Python/runtime family used by the deployed inference image.
RUN dnf install -y mesa-libGL && dnf clean all
COPY requirements-train.txt /tmp/pothole-requirements-train.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/pothole-requirements-train.txt
RUN python3 -c "import cv2, ultralytics; assert cv2.__version__ == '4.10.0'"

WORKDIR /workspace
ENTRYPOINT ["python3", "ml/yolo/release.py"]
